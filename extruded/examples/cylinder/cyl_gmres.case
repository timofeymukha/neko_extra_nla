{
  "version": 1.0,
  "case": {
    "mesh_file": "cylinder.nmsh",
    "output_at_end": false,
    "output_boundary": false,
    "output_checkpoints": false,
    "checkpoint_control": "simulationtime",
    "checkpoint_value": 50.0,
    "time": {
      "end_time": 0.2,
      "variable_timestep": false,
      "timestep": 0.004
    },
    "numerics": {
      "time_order": 3,
      "polynomial_order": 7,
      "dealias": true
    },
    "fluid": {
      "scheme": "pnpn",
      "Re": 200.0,
      "initial_condition": {
        "type": "uniform",
        "value": [
          1.0,
          0.0,
          0.0
        ]
      },
      "velocity_solver": {
        "type": "cg",
        "preconditioner": {
          "type": "jacobi"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-07,
        "max_iterations": 800
      },
      "pressure_solver": {
        "type": "gmres",
        "preconditioner": {
          "type": "extruded"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-09,
        "max_iterations": 100
      },
      "boundary_conditions": [
        {
          "type": "velocity_value",
          "value": [
            1.0,
            0.0,
            0.0
          ],
          "zone_indices": [
            1
          ]
        },
        {
          "type": "outflow+dong",
          "zone_indices": [
            2
          ]
        },
        {
          "type": "normal_outflow",
          "value": [
            1.0,
            0.0,
            0.0
          ],
          "zone_indices": [
            5
          ]
        },
        {
          "type": "normal_outflow",
          "value": [
            1.0,
            0.0,
            0.0
          ],
          "zone_indices": [
            6
          ]
        },
        {
          "type": "no_slip",
          "zone_indices": [
            7
          ]
        }
      ],
      "output_control": "never",
      "output_value": 2.0
    }
  }
}
